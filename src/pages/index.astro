    <meta name="description" content="Hostal a 50 metros de la playa de La Barra, Buenaventura. Habitaciones con ventilador y toldillo, internet satelital, café recién hecho. Avistamiento de ballenas de julio a octubre. Desde $60.000 COP por persona.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #F4EFE6;
            --bg2: #E9E2D4;
            --ink: #1F2A24;
            --deep: #2F5D50;
            --accent: #E07A5F;
            --accentDark: #c86348;
            --onDeep: #F6F1E8;
            --gold: #C9A24B;
            --muted: rgba(31,42,36,.68);
            --rule: rgba(31,42,36,.12);
            --faint: rgba(31,42,36,.46);
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
        a { color: inherit; text-decoration: none; }
        a:hover { color: var(--accent); }
        img, video { max-width: 100%; display: block; }

        .desktop-video { display: block; width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
        .mobile-video { display: none; width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
        @media (max-width: 820px) {
            .desktop-video { display: none; }
            .mobile-video { display: block; }
        }

        .btn-primary {
            background: var(--accent);
            color: var(--onDeep);
            border-radius: 3px;
            padding: 14px 26px;
            font-size: 15px;
            font-weight: 600;
            display: inline-block;
            transition: background 0.2s;
            text-align: center;
        }
        .btn-primary:hover {
            background: var(--accentDark);
            color: var(--onDeep);
        }

        .lang-switch {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 500;
            background: rgba(31,42,36,0.06);
            padding: 6px 12px;
            border-radius: 20px;
        }
        .lang-switch a { opacity: 0.6; transition: opacity 0.2s; }
        .lang-switch a.active { opacity: 1; font-weight: 600; color: var(--accent); }

        @keyframes heroFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .hero-content { animation: heroFadeIn 0.9s ease-out 0.1s both; }
        @media (prefers-reduced-motion: reduce) {
            .hero-content { animation: none; }
        }

        .header-inner { padding: 18px 40px; }
        .menu-toggle { 
            display: none; 
            background: none; 
            border: none; 
            cursor: pointer; 
            padding: 8px; 
            align-items: center; 
            justify-content: center; 
            z-index: 100; 
        }
        .mobile-whatsapp-bar { display: none; }

        .top-bar {
            background: var(--deep);
            color: rgba(246,241,232,.85);
            padding: 9px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: ui-monospace, Menlo, monospace;
            font-size: 10.5px;
            letter-spacing: .14em;
            text-transform: uppercase;
            overflow: hidden;
            transition: max-height 0.3s ease, padding 0.3s ease, opacity 0.3s ease;
        }
        .top-bar a { color: inherit; transition: color 0.2s; }
        .top-bar a:hover { color: var(--onDeep); text-decoration: underline; }

        @media (max-width: 1024px) {
            .top-bar {
                max-height: 0;
                padding-top: 0;
                padding-bottom: 0;
                opacity: 0;
                pointer-events: none;
                border: none;
            }
        }

        .mobile-menu {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 95;
            background: var(--deep);
            flex-direction: column;
            justify-content: space-between;
            padding: 32px 32px calc(32px + env(safe-area-inset-bottom));
            opacity: 0;
            transition: opacity 0.25s ease-in-out;
        }
        .mobile-menu.open { display: flex; opacity: 1; }
        .mobile-menu-header { display: flex; align-items: center; justify-content: space-between; width: 100%; }
        .mobile-menu nav { display: flex; flex-direction: column; gap: 18px; margin: auto 0; }
        .mobile-menu nav a { font-family: 'Lora', Georgia, serif; font-size: 28px; font-weight: 500; color: var(--onDeep); transition: color 0.2s; }
        .mobile-menu nav a:hover { color: var(--accent); }
        .mobile-menu-footer { display: flex; flex-direction: column; gap: 20px; width: 100%; border-top: 1px solid rgba(246,241,232,0.15); padding-top: 20px; }

        .map-card { background: var(--bg); border: 1px solid var(--rule); border-radius: 8px; padding: 24px; margin-bottom: 28px; }
        .route-point { cursor: pointer; }
        .route-point circle.dot { transition: r 0.2s; }
        .route-point:hover circle.dot { r: 8; }

        .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 28px; }
        .step-card { background: var(--bg); border: 1px solid var(--rule); border-radius: 8px; padding: 24px; display: flex; gap: 16px; align-items: flex-start; }
        .step-icon { width: 44px; height: 44px; border-radius: 50%; background: var(--deep); display: flex; align-items: center; justify-content: center; flex: none; }
        .step-title { font-family: 'Lora', Georgia, serif; font-size: 18px; font-weight: 500; margin: 0 0 4px; }
        .step-meta { font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); margin: 0 0 6px; }
        .step-desc { font-size: 14px; line-height: 1.5; color: var(--muted); margin: 0; }

        .maps-link { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--deep); border: 1px solid var(--rule); border-radius: 20px; padding: 9px 16px; }
        .maps-link:hover { color: var(--accent); border-color: var(--accent); }

        .social-icons-footer { display: flex; gap: 12px; margin-top: 4px; }
        .social-icon-btn {
            width: 38px; height: 38px; border-radius: 50%;
            background: rgba(246, 241, 232, 0.08);
            border: 1px solid rgba(246, 241, 232, 0.15);
            display: flex; align-items: center; justify-content: center;
            color: var(--onDeep); transition: all 0.2s ease;
        }
        .social-icon-btn:hover { background: var(--accent); border-color: var(--accent); color: var(--onDeep); transform: translateY(-2px); }

        .desktop-actions { display: flex; align-items: center; gap: 12px; flex-wrap: nowrap; }

        @media (max-width: 1024px) {
            .header-inner { padding: 14px 24px; }
            .desktop-nav, .desktop-actions { display: none !important; }
            .menu-toggle { display: flex !important; }
            #rooms { grid-template-columns: 1fr !important; padding: 60px 24px !important; gap: 40px !important; }
            #news > div { grid-template-columns: 1fr !important; gap: 32px !important; }
            footer > div:first-child { grid-template-columns: 1fr !important; gap: 32px !important; }
            .mobile-whatsapp-bar { 
                display: flex; position: fixed; bottom: 0; left: 0; right: 0; z-index: 80; 
                background: var(--bg); border-top: 1px solid var(--rule); 
                padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); 
            }
            body { padding-bottom: 68px; }
        }

        @media (max-width: 600px) {
            .steps { grid-template-columns: 1fr; }
            .header-inner { padding: 14px 16px; }
            main section { padding-left: 16px !important; padding-right: 16px !important; }
            footer { padding: 40px 16px 20px !important; }
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const mobileMenu = document.getElementById('mobileMenu');
            const menuToggleOpen = document.querySelectorAll('.menu-toggle');
            const menuToggleClose = document.querySelector('.mobile-menu .menu-toggle');
            const menuLinks = document.querySelectorAll('.mobile-menu nav a');
            
            if (mobileMenu) {
                const openMenu = () => { mobileMenu.classList.add('open'); document.body.style.overflow = 'hidden'; };
                const closeMenu = () => { mobileMenu.classList.remove('open'); document.body.style.overflow = ''; };
                menuToggleOpen.forEach(toggle => toggle.addEventListener('click', openMenu));
                if (menuToggleClose) menuToggleClose.addEventListener('click', closeMenu);
                menuLinks.forEach(link => link.addEventListener('click', closeMenu));
            }
        });
    </script>
</head>
