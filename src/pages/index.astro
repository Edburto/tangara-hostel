<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tangara Hostel · La Barra, Pacífico colombiano — hostal frente a la playa</title>
    <meta name="description" content="Hostal a 50 metros de la playa de La Barra, Buenaventura. Habitaciones con ventilador y toldillo, internet satelital, café recién hecho. Avistamiento de ballenas de julio a octubre. Desde $60.000 COP por persona.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #F4EFE6;
            --bg2: #E9E2D4;
            --ink: #1F2A24;
            --deep: #2F5D50;
            --accent: #E07A5F;
            --accentDark: #c86348;
            --onDeep: #F6F1E8;
            --gold: #C9A24B;
            --muted: rgba(31,42,36,.68);
            --rule: rgba(31,42,36,.12);
            --faint: rgba(31,42,36,.46);
        }
        body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        a:hover { color: var(--accent); }
        img, video { max-width: 100%; display: block; }

        .desktop-video { display: block; width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
        .mobile-video { display: none; width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
        @media (max-width: 820px) {
            .desktop-video { display: none; }
            .mobile-video { display: block; }
        }

        .btn-primary {
            background: var(--accent);
            color: var(--onDeep);
            border-radius: 3px;
            padding: 14px 26px;
            font-size: 15px;
            font-weight: 600;
            display: inline-block;
            transition: background 0.2s;
        }
        .btn-primary:hover {
            background: var(--accentDark);
            color: var(--onDeep);
        }
        .lang-switch {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 500;
            background: rgba(31,42,36,0.06);
            padding: 6px 12px;
            border-radius: 20px;
        }
        .lang-switch a { opacity: 0.6; transition: opacity 0.2s; }
        .lang-switch a.active { opacity: 1; font-weight: 600; color: var(--accent); }

        @keyframes heroFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .hero-content { animation: heroFadeIn 0.9s ease-out 0.1s both; }
        @media (prefers-reduced-motion: reduce) {
            .hero-content { animation: none; }
        }

        .header-inner { padding: 18px 40px; }
        .menu-toggle { display: none; background: none; border: none; cursor: pointer; padding: 6px; align-items: center; justify-content: center; }
        .mobile-whatsapp-bar { display: none; }

        .lang-toggle-mobile {
            display: none;
            position: relative;
            align-items: center;
            gap: 6px;
            background: rgba(31,42,36,.06);
            border: none;
            border-radius: 20px;
            padding: 7px 12px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            color: var(--ink);
        }
        .lang-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background: var(--bg);
            border: 1px solid var(--rule);
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(0,0,0,.14);
            padding: 6px;
            min-width: 140px;
            z-index: 50;
        }
        .lang-dropdown.open { display: block; }
        .lang-dropdown a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 10px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
        }
        .lang-dropdown a.active { background: rgba(224,122,95,.1); color: var(--accent); font-weight: 600; }
        .lang-dropdown a:not(.active):hover { background: rgba(31,42,36,.05); }

        .mobile-menu {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 90;
            background: var(--deep);
            flex-direction: column;
        }
        .mobile-menu.open { display: flex; }
        .mobile-menu-header { display: flex; align-items: center; justify-content: space-between; padding: 18px 24px; }
        .mobile-menu nav { display: flex; flex-direction: column; padding: 12px 24px; }
        .mobile-menu nav a {
            padding: 17px 0;
            border-bottom: 1px solid rgba(246,241,232,.15);
            font-family: 'Lora', Georgia, serif;
            font-size: 22px;
            font-weight: 500;
            color: var(--onDeep);
        }
        .mobile-menu .lang-switch-mobile {
            margin-top: auto;
            padding: 24px;
            display: flex;
            gap: 18px;
            justify-content: center;
            font-size: 14px;
        }
        .mobile-menu .lang-switch-mobile a { color: rgba(246,241,232,.6); }
        .mobile-menu .lang-switch-mobile a.active { color: var(--onDeep); font-weight: 600; }

        .map-card { background: var(--bg); border: 1px solid var(--rule); border-radius: 8px; padding: 24px; margin-bottom: 28px; }
        .route-point { cursor: pointer; }
        .route-point circle.dot { transition: r 0.2s; }
        .route-point:hover circle.dot { r: 8; }
        .route-tooltip { opacity: 0; pointer-events: none; transition: opacity 0.2s; }
        .route-point:hover + .route-tooltip,
        .route-tooltip:hover { opacity: 1; }

        .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 28px; }
        .step-card { background: var(--bg); border: 1px solid var(--rule); border-radius: 8px; padding: 24px; display: flex; gap: 16px; align-items: flex-start; }
        .step-icon { width: 44px; height: 44px; border-radius: 50%; background: var(--deep); display: flex; align-items: center; justify-content: center; flex: none; }
        .step-title { font-family: 'Lora', Georgia, serif; font-size: 18px; font-weight: 500; margin: 0 0 4px; }
        .step-meta { font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); margin: 0 0 6px; }
        .step-desc { font-size: 14px; line-height: 1.5; color: var(--muted); margin: 0; }

        .maps-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--deep);
            border: 1px solid var(--rule);
            border-radius: 20px;
            padding: 9px 16px;
        }
        .maps-link:hover { color: var(--accent); border-color: var(--accent); }

        @media (max-width: 600px) {
            .top-bar { flex-direction: column; align-items: flex-start; gap: 4px; padding: 8px 20px; }
            .steps { grid-template-columns: 1fr; }
        }

        @media (max-width: 820px) {
            .header-inner { padding: 14px 20px; }
            .desktop-nav, .desktop-actions { display: none; }
            .menu-toggle { display: flex; }
            .lang-toggle-mobile { display: flex; }
            .mobile-whatsapp-bar {
                display: flex;
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                z-index: 80;
                background: var(--bg);
                border-top: 1px solid var(--rule);
                padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
            }
            .mobile-whatsapp-bar a { flex: 1; text-align: center; }
            body { padding-bottom: 68px; }
        }
    </style>
</head>
<body>

  <div class="top-bar" style="background: var(--deep); color: rgba(246,241,232,.8); padding: 9px 40px; display: flex; justify-content: space-between; align-items: center; font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase;">
    <span>Temporada de ballenas · Julio – Octubre</span>
    <span>La Barra, Pacífico colombiano · 15 min desde Juanchaco</span>
  </div>

  <header style="position: sticky; top: 0; z-index: 40; background: rgba(244, 239, 230, 0.93); backdrop-filter: blur(14px); border-bottom: 1px solid var(--rule);">
    <div class="header-inner" style="max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px;">
      <a href="#top" style="display: flex; align-items: center; gap: 11px;">
        <img src="/uploads/702876787_10165380027888900_2312760133940339429_n.jpg" alt="Logo Tangara Hostel" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
        <span style="font-family: 'Lora', Georgia, serif; font-weight: 700; font-size: 21px; letter-spacing: -.012em;">Tangara Hostel</span>
      </a>
      <nav class="desktop-nav" style="display: flex; align-items: center; gap: 24px; font-size: 14.5px; font-weight: 500;">
        <a href="#rooms">Habitaciones</a>
        <a href="#whales">Ballenas</a>
        <a href="#getting-here">Cómo llegar</a>
        <a href="#news">Noticias</a>
        <a href="#playlist">Playlist</a>
        <a href="#contact">Contacto</a>
      </nav>

      <div class="desktop-actions" style="display: flex; align-items: center; gap: 16px;">
        <div class="lang-switch">
          <a href="#es" class="active" title="Español">🇪🇸 ES</a>
          <span style="opacity: 0.3;">/</span>
          <a href="#en" title="English">🇬🇧 EN</a>
          <span style="opacity: 0.3;">/</span>
          <a href="#fr" title="Français">🇫🇷 FR</a>
        </div>

        <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n" target="_blank" class="btn-primary" style="padding: 10px 18px; font-size: 14px;">Reservar WhatsApp</a>
      </div>

      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="position: relative;">
          <button class="lang-toggle-mobile" type="button" aria-label="Cambiar idioma" onclick="document.getElementById('langDropdown').classList.toggle('open')">
            <span>🇪🇸 ES</span>
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3.5L5 6.5L8 3.5"/></svg>
          </button>
          <div class="lang-dropdown" id="langDropdown">
            <a href="#es" class="active" title="Español">🇪🇸 Español</a>
            <a href="#en" title="English">🇬🇧 English</a>
            <a href="#fr" title="Français">🇫🇷 Français</a>
          </div>
        </div>

        <button class="menu-toggle" type="button" aria-label="Abrir menú" onclick="document.getElementById('mobileMenu').classList.add('open'); document.body.style.overflow='hidden';">
          <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="var(--ink)" stroke-width="1.8" stroke-linecap="round"><line x1="4" y1="8" x2="22" y2="8"/><line x1="4" y1="13" x2="22" y2="13"/><line x1="4" y1="18" x2="22" y2="18"/></svg>
        </button>
      </div>
    </div>
  </header>

  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-header">
      <span style="font-family: 'Lora', Georgia, serif; font-weight: 700; font-size: 19px; color: var(--onDeep);">Tangara Hostel</span>
      <button class="menu-toggle" type="button" aria-label="Cerrar menú" style="display: flex;" onclick="document.getElementById('mobileMenu').classList.remove('open'); document.body.style.overflow='';">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--onDeep)" stroke-width="1.8" stroke-linecap="round"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
      </button>
    </div>
    <nav onclick="if(event.target.tagName==='A'){document.getElementById('mobileMenu').classList.remove('open'); document.body.style.overflow='';}">
      <a href="#rooms">Habitaciones</a>
      <a href="#whales">Ballenas</a>
      <a href="#getting-here">Cómo llegar</a>
      <a href="#news">Noticias</a>
      <a href="#playlist">Playlist</a>
      <a href="#contact">Contacto</a>
      <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n" target="_blank" style="color: var(--accent);">Reservar por WhatsApp →</a>
    </nav>
    <div class="lang-switch-mobile">
      <a href="#es" class="active" title="Español">🇪🇸 ES</a>
      <a href="#en" title="English">🇬🇧 EN</a>
      <a href="#fr" title="Français">🇫🇷 FR</a>
    </div>
  </div>

  <div class="mobile-whatsapp-bar">
    <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n" target="_blank" class="btn-primary" style="padding: 12px 18px; font-size: 14.5px;">Reservar por WhatsApp</a>
  </div>

  <main>
    <section id="top" style="width: 100%;">
      <div style="position: relative; width: 100%; height: 85vh; min-height: 600px; overflow: hidden; background: var(--deep);">
        <video class="desktop-video" src="/uploads/TangaraWebHor2.mp4" autoplay muted loop playsinline preload="auto" poster="/uploads/IMG-20260420-WA0009.jpg"></video>
        <video class="mobile-video" src="/uploads/WEBTANGARAVERTICAL.mp4" autoplay muted loop playsinline preload="auto" poster="/uploads/IMG-20260420-WA0009.jpg"></video>

        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(28,26,23,.82) 0%, rgba(28,26,23,.3) 45%, transparent 75%);"></div>

        <div style="position: absolute; left: 40px; right: 40px; bottom: 50px; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; z-index: 2; max-width: 1280px; margin: 0 auto; width: calc(100% - 80px);">
          <div class="hero-content" style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start; max-width: 760px;">
            <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: rgba(246,241,232,.7);">La Barra · Pacífico colombiano</span>
            <h1 style="margin: 0; display: flex; flex-direction: column; gap: 10px; font-family: 'Lora', Georgia, serif; font-weight: 500; color: var(--onDeep);">
              <span style="font-size: 50px; line-height: 1.05;">Hostal en la playa de La Barra, Pacífico Colombiano</span>
              <span style="font-size: 26px; line-height: 1.2; font-weight: 400; color: rgba(246,241,232,.82);">Tangara, en la costa de las ballenas</span>
            </h1>
            <p style="margin: 0; max-width: 500px; font-size: 16px; line-height: 1.5; color: rgba(246,241,232,.78);">A cincuenta metros de una playa tranquila y segura del Pacífico colombiano — ventiladores, toldillos, internet satelital y café recién hecho cada mañana.</p>
            <div style="display: flex; gap: 16px; margin-top: 6px;">
              <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n" target="_blank" class="btn-primary" style="padding: 14px 26px; font-size: 15px;">Reserva por WhatsApp</a>
            </div>
          </div>
          <div style="text-align: right; color: rgba(246,241,232,.8); display: flex; flex-direction: column; gap: 4px; flex: none;">
            <span style="font-family: 'Lora', Georgia, serif; font-size: 32px; font-weight: 500; color: var(--onDeep);">$60.000</span>
            <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase;">COP · persona / noche</span>
          </div>
        </div>
      </div>
    </section>

    <section id="rooms" style="max-width: 1280px; margin: 0 auto; padding: 96px 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 56px;">
      <div style="display: flex; flex-direction: column; gap: 18px;">
        <img src="/uploads/IMG-20260406-WA0063.jpg" alt="Hamacas en la terraza" style="width: 100%; height: 340px; object-fit: cover; border-radius: 3px;" />
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .16em; color: var(--deep);">01 — Alojamiento</span>
        <h2 style="margin: 0; font-family: 'Lora', Georgia, serif; font-weight: 500; font-size: 38px;">Habitaciones frescas, café al amanecer</h2>
        <p style="margin: 0; max-width: 520px; font-size: 16.5px; line-height: 1.55; color: var(--muted);">Habitaciones con ventilador y toldillo para dormir bien protegido, y un termo de café recién hecho cada mañana. Internet satelital de alta velocidad y energía en toda la casa.</p>
        <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20cama%20por%20$60.000%20COP" target="_blank" class="maps-link" style="align-self: flex-start; margin-top: 4px;">Reservar esta habitación →</a>
      </div>
      <div style="display: flex; flex-direction: column; gap: 18px;" id="whales">
        <img src="/uploads/IMG-20260420-WA0011.jpg" alt="Entrada al hostal" style="width: 100%; height: 340px; object-fit: cover; border-radius: 3px;" />
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .16em; color: var(--deep);">02 — Salir</span>
        <h2 style="margin: 0; font-family: 'Lora', Georgia, serif; font-weight: 500; font-size: 38px;">Ballenas, manglares y surf</h2>
        <p style="margin: 0; max-width: 520px; font-size: 16.5px; line-height: 1.55; color: var(--muted);">Avistamiento de ballenas y de aves en temporada, senderos ecológicos por los esteros, pesca de pargo en el manglar y las olas que hicieron de La Barra un punto clave del surf.</p>
        <a href="https://wa.me/573152395357?text=Hola,%20quiero%20informaci%C3%B3n%20sobre%20el%20avistamiento%20de%20ballenas" target="_blank" class="maps-link" style="align-self: flex-start; margin-top: 4px;">Preguntar por ballenas →</a>
      </div>
    </section>

    <section id="getting-here" style="background: var(--bg2); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 80px 40px;">
      <div style="max-width: 1280px; margin: 0 auto;">
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: var(--deep); display: block; margin-bottom: 12px;">Guía de viaje y ubicación</span>
        <h2 style="margin: 0 0 40px 0; font-family: 'Lora', Georgia, serif; font-weight: 500; font-size: 38px;">Cómo llegar a Tangara Hostel</h2>

        <div class="map-card">
          <div style="position: relative; width: 100%; border-radius: 6px; overflow: hidden;">
            <img src="/uploads/mapa-ruta-base.png" alt="Mapa base de Bahía Málaga y Bahía de Buenaventura" style="width: 100%; display: block;" />
            <svg style="position: absolute; inset: 0; width: 100%; height: 100%;" viewBox="0 0 1244 809" role="img" aria-label="Mapa de ruta desde Buenaventura hasta La Barra, dentro del Parque Nacional Natural Uramba">
              <title>Ruta Buenaventura → Bahía Málaga → La Barra, Parque Nacional Natural Uramba</title>
              <defs>
                <marker id="boatArrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto">
                  <path d="M1 1L9 5L1 9" fill="none" stroke="#C0392B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </marker>
              </defs>

              <text x="500" y="45" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-size="14" letter-spacing=".5" fill="#3F6B4C" font-weight="700">PARQUE NACIONAL NATURAL URAMBA</text>
              <text x="150" y="730" font-family="ui-monospace, Menlo, monospace" font-size="15" letter-spacing="1" fill="#4B7B90" opacity="0.85">OCÉANO PACÍFICO</text>
              <text x="620" y="255" text-anchor="middle" font-family="Lora, Georgia, serif" font-size="19" font-style="italic" fill="#3F6B4C" opacity="0.9">Bahía Málaga</text>
              <text x="950" y="465" text-anchor="middle" font-family="Lora, Georgia, serif" font-size="16" font-style="italic" fill="#6B5D3A" opacity="0.9">Bahía de Buenaventura</text>

              <!-- red route: lancha, traced from the real hand-marked route -->
              <path id="boatRoute" d="M985,573 C963,607 942,636 920,656 C899,669 877,682 856,694 C834,704 813,710 791,713 C770,715 748,717 727,718 C705,719 684,720 662,720 C641,720 619,719 598,717 C576,709 555,698 533,672 C512,649 490,600 469,566 C447,532 426,490 422,476" fill="none" stroke="#C0392B" stroke-width="5" stroke-linecap="round" stroke-dasharray="11 9">
                <animate attributeName="stroke-dashoffset" from="0" to="-40" dur="1.4s" repeatCount="indefinite"/>
              </path>

              <!-- blue route: tuk-tuk -->
              <path id="tukRoute" d="M422,476 C412,475 406,473 401,470 C396,464 391,458 385,449 C380,441 377,439 375,438" fill="none" stroke="#2255A4" stroke-width="5" stroke-linecap="round" stroke-dasharray="6 7">
                <animate attributeName="stroke-dashoffset" from="0" to="-26" dur="1s" repeatCount="indefinite"/>
              </path>

              <g class="route-point" tabindex="0">
                <circle class="dot" cx="985" cy="573" r="9" fill="#C0392B" stroke="#F6F1E8" stroke-width="2"/>
                <text x="985" y="547" text-anchor="middle" font-family="Lora, Georgia, serif" font-size="19" font-weight="600" fill="#1F2A24">Buenaventura</text>
              </g>
              <g class="route-tooltip">
                <rect x="905" y="588" width="160" height="44" rx="6" fill="#C0392B"/>
                <text x="985" y="606" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#F6F1E8">Muelle turístico</text>
                <text x="985" y="623" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#F6F1E8">Punto de partida</text>
              </g>

              <g class="route-point" tabindex="0">
                <circle class="dot" cx="422" cy="476" r="7" fill="#2255A4" stroke="#F6F1E8" stroke-width="2"/>
                <text x="422" y="504" text-anchor="middle" font-family="Lora, Georgia, serif" font-size="18" font-weight="600" fill="#1F2A24">Juanchaco</text>
              </g>
              <g class="route-tooltip">
                <rect x="440" y="510" width="165" height="44" rx="6" fill="#C0392B"/>
                <text x="522" y="528" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill="#F6F1E8">45 min en lancha</text>
