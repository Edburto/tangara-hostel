      <div style="border-top: 1px solid rgba(246,241,232,.2); padding-top: 18px; display: flex; justify-content: space-between; font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: rgba(246,241,232,.5);">
        <span>© 2026 Tangara Hostel</span><span>Pacífico colombiano</span>
