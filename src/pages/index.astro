      </div>
      <div style="display: flex; flex-direction: column; gap: 11px;">
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: rgba(246,241,232,.5);">Visita</span>
        <a href="#rooms" style="font-size: 15px; color: rgba(246,241,232,.8);">Habitaciones</a>
        <a href="#whales" style="font-size: 15px; color: rgba(246,241,232,.8);">Ballenas</a>
        <a href="#news" style="font-size: 15px; color: rgba(246,241,232,.8);">Noticias</a>
