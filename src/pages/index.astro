      <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(28,26,23,.4) 0%, rgba(28,26,23,.62) 100%);"></div>
      <div style="position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; text-align: center; padding: 0 24px;">
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: rgba(246,241,232,.75);">Una experiencia inolvidable</span>
        <h2 style="margin: 0; font-family: 'Lora', Georgia, serif; font-weight: 500; font-size: 34px; color: var(--onDeep); max-width: 560px;">Vive Tangara por dentro</h2>
      </div>
    </section>
  </main>

