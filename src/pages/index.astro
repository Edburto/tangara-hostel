                    navGettingHere: "Cómo llegar",
                    navContact: "Contacto",
                    btnBook: "Reservar WhatsApp",
                    heroTag: "La Barra · Pacífico colombiano",
                    heroTitle: "Hostal en la playa de La Barra, Pacífico Colombiano",
                    heroSubtitle: "Tangara, en la costa de las ballenas",
                    heroDesc: "A cincuenta metros de una playa tranquila y segura del Pacífico colombiano — ventiladores, toldillos, internet satelital y café recién hecho cada mañana.",
                    priceUnit: "COP · persona / noche",
                    roomTag: "01 — Alojamiento",
                    roomTitle: "Habitaciones frescas, café al amanecer",
                    roomDesc: "Habitaciones con ventilador y toldillo para dormir bien protegido, y un termo de café recién hecho cada mañana. Internet satelital de alta velocidad y energía en toda la casa.",
                    btnBookRoom: "Reservar esta habitación →",
                    whaleTag: "02 — Salir",
                    whaleTitle: "Ballenas, manglares y surf",
                    whaleDesc: "Avistamiento de ballenas y de aves en temporada, senderos ecológicos por los esteros, pesca de pargo en el manglar y las olas que hicieron de La Barra un punto clave del surf.",
                    btnAskWhales: "Preguntar por ballenas →",
                    guideTag: "Guía de viaje y ubicación",
                    guideTitle: "Cómo llegar a Tangara Hostel",
                    step1Meta: "Etapa 1 · 45 min",
                    step1Title: "Lancha a Juanchaco",
                    step1Desc: "Desde el muelle turístico de Buenaventura, lancha rápida y cubierta hasta Juanchaco.",
                    step2Meta: "Etapa 2 · 10 min",
                    step2Title: "Tuk-tuk a La Barra",
                    step2Desc: "Al llegar a Juanchaco, un tuk-tuk local atraviesa la trocha o la playa hasta Tangara.",
                    step3Meta: "Llegada",
                    step3Title: "¡Llegaste a Tangara!",
                    step3Desc: "Preguntas por Tangara Hostel a 50 metros de la playa. Te recibimos con café recién hecho.",
                    formTag: "¿Dudas o reservas?",
                    formTitle: "Contáctanos y Reserva",
                    formDesc: "Escríbenos tus fechas, cuántas personas viajan o cualquier consulta. Al enviar, te conectaremos de inmediato con nuestro WhatsApp.",
                    labelName: "Tu Nombre",
                    labelDetails: "Fechas estimadas y número de personas",
                    labelMsg: "Mensaje o consulta adicional",
                    btnSubmit: "Enviar por WhatsApp 🦜"
                },
                en: {
                    topWhales: "🐋 Whale season · July – October",
                    topLocation: "La Barra, Colombian Pacific · 10 min from Juanchaco",
                    navRooms: "Rooms",
                    navWhales: "Whales",
                    navGettingHere: "How to get here",
                    navContact: "Contact",
                    btnBook: "Book on WhatsApp",
                    heroTag: "La Barra · Colombian Pacific",
                    heroTitle: "Hostel on the beach in La Barra, Colombian Pacific",
                    heroSubtitle: "Tangara, on the whale coast",
                    heroDesc: "Fifty meters from a quiet, safe beach in the Colombian Pacific — fans, mosquito nets, satellite internet, and fresh coffee every morning.",
                    priceUnit: "COP · person / night",
                    roomTag: "01 — Stay",
                    roomTitle: "Fresh rooms, coffee at sunrise",
                    roomDesc: "Rooms with fans and mosquito nets for a protected rest, plus a thermos of fresh coffee every morning. High-speed satellite internet and power throughout.",
                    btnBookRoom: "Book this room →",
                    whaleTag: "02 — Explore",
                    whaleTitle: "Whales, mangroves & surf",
                    whaleDesc: "Seasonal whale and bird watching, eco-trails through estuaries, snapper fishing in the mangroves, and waves that made La Barra a surf spot.",
                    btnAskWhales: "Ask about whales →",
                    guideTag: "Travel Guide & Location",
                    guideTitle: "How to get to Tangara Hostel",
                    step1Meta: "Step 1 · 45 min",
                    step1Title: "Boat to Juanchaco",
                    step1Desc: "From Buenaventura tourist pier, take a covered speedboat to Juanchaco.",
                    step2Meta: "Step 2 · 10 min",
                    step2Title: "Tuk-tuk to La Barra",
                    step2Desc: "Upon arrival in Juanchaco, a local tuk-tuk crosses the trail or beach to Tangara.",
                    step3Meta: "Arrival",
                    step3Title: "Welcome to Tangara!",
                    step3Desc: "Ask for Tangara Hostel 50 meters from the beach. Fresh coffee awaits you.",
                    formTag: "Questions or Bookings?",
                    formTitle: "Contact & Bookings",
                    formDesc: "Send us your dates, group size, or questions. Submitting connects you directly to our WhatsApp.",
                    labelName: "Your Name",
                    labelDetails: "Estimated dates & number of guests",
                    labelMsg: "Additional message or request",
                    btnSubmit: "Send via WhatsApp 🦜"
                },
                fr: {
                    topWhales: "🐋 Saison des baleines · Juillet – Octobre",
                    topLocation: "La Barra, Pacifique colombien · 10 min de Juanchaco",
                    navRooms: "Chambres",
                    navWhales: "Baleines",
                    navGettingHere: "Comment venir",
                    navContact: "Contact",
                    btnBook: "Réserver par WhatsApp",
                    heroTag: "La Barra · Pacifique colombien",
                    heroTitle: "Auberge sur la plage de La Barra, Pacifique Colombien",
                    heroSubtitle: "Tangara, sur la côte des baleines",
                    heroDesc: "À 50 mètres d'une plage calme et sécurisée du Pacifique colombien — ventilateurs, moustiquaires, internet satellite et café frais chaque matin.",
                    priceUnit: "COP · personne / nuit",
                    roomTag: "01 — Hébergement",
                    roomTitle: "Chambres fraîches, café au lever du soleil",
                    roomDesc: "Chambres équipées de ventilateurs et moustiquaires pour un repos protégé. Café frais chaque matin, internet satellite haut débit et électricité.",
                    btnBookRoom: "Réserver cette chambre →",
                    whaleTag: "02 — Explorer",
                    whaleTitle: "Baleines, mangroves et surf",
                    whaleDesc: "Observation des baleines et oiseaux en saison, sentiers écologiques dans les estuaires, pêche dans la mangrove et superbes vagues de surf.",
                    btnAskWhales: "Infos sur les baleines →",
                    guideTag: "Guide de voyage et localisation",
                    guideTitle: "Comment se rendre à Tangara Hostel",
                    step1Meta: "Étape 1 · 45 min",
                    step1Title: "Bateau vers Juanchaco",
                    step1Desc: "Depuis l'embarcadère touristique de Buenaventura, bateau rapide couvert vers Juanchaco.",
                    step2Meta: "Étape 2 · 10 min",
                    step2Title: "Tuk-tuk vers La Barra",
                    step2Desc: "À Juanchaco, un tuk-tuk local traverse la piste ou la plage jusqu'à Tangara.",
                    step3Meta: "Arrivée",
                    step3Title: "Bienvenue à Tangara !",
                    step3Desc: "Demandez Tangara Hostel à 50 mètres de la plage. Nous vous accueillons avec du café frais.",
                    formTag: "Questions ou réservations ?",
                    formTitle: "Contact & Réservations",
                    formDesc: "Envoyez-nous vos dates et le nombre de personnes. Vous serez redirigé vers notre WhatsApp.",
                    labelName: "Votre Nom",
                    labelDetails: "Dates estimées et nombre de personnes",
                    labelMsg: "Message ou demande supplémentaire",
                    btnSubmit: "Envoyer par WhatsApp 🦜"
                }
            };

            window.changeLanguage = function(lang) {
                const dict = translations[lang];
                if (!dict) return;

                document.documentElement.lang = lang;

                // Actualizar textos con data-i18n
                document.querySelectorAll('[data-i18n]').forEach(element => {
                    const key = element.getAttribute('data-i18n');
                    if (dict[key]) element.textContent = dict[key];
                });

                // Cambiar estado activo en los botones
                document.querySelectorAll('.lang-btn').forEach(btn => {
                    btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
                });

                // Guardar preferencia
                localStorage.setItem('tangara_lang', lang);
            };

            // Cargar idioma previo si existe
            const savedLang = localStorage.getItem('tangara_lang') || 'es';
            if (savedLang !== 'es') window.changeLanguage(savedLang);
        });
    </script>
</head>
<body>

  <div class="top-bar">
    <a href="#whales"><span data-i18n="topWhales">🐋 Temporada de ballenas · Julio – Octubre</span></a>
    <a href="#getting-here"><span data-i18n="topLocation">La Barra, Pacífico colombiano · 10 min desde Juanchaco</span></a>
  </div>

  <header style="position: sticky; top: 0; z-index: 40; background: rgba(244, 239, 230, 0.93); backdrop-filter: blur(14px); border-bottom: 1px solid var(--rule);">
    <div class="header-inner" style="max-width: 1280px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 20px;">
      <a href="#top" style="display: flex; align-items: center; gap: 11px; flex: none;">
        <img src="/uploads/logo-tangara.png" alt="Tangara Hostel Logo" style="height: 48px; width: auto; object-fit: contain;" />
        <span style="font-family: 'Lora', Georgia, serif; font-weight: 700; font-size: 20px; letter-spacing: -.012em;">Tangara Hostel</span>
      </a>
      
      <nav class="desktop-nav" style="display: flex; align-items: center; gap: 20px; font-size: 14px; font-weight: 500;">
        <a href="#rooms" data-i18n="navRooms">Habitaciones</a>
        <a href="#whales" data-i18n="navWhales">Ballenas</a>
        <a href="#getting-here" data-i18n="navGettingHere">Cómo llegar</a>
        <a href="#contact-form-section" data-i18n="navContact">Contacto</a>
      </nav>

      <div class="desktop-actions">
        <div class="lang-switch">
          <button type="button" class="lang-btn active" data-lang="es" aria-label="Cambiar idioma a Español" onclick="changeLanguage('es')">🇪🇸 ES</button>
          <span style="opacity: 0.3;">/</span>
          <button type="button" class="lang-btn" data-lang="en" aria-label="Switch language to English" onclick="changeLanguage('en')">🇬🇧 EN</button>
          <span style="opacity: 0.3;">/</span>
          <button type="button" class="lang-btn" data-lang="fr" aria-label="Changer de langue en Français" onclick="changeLanguage('fr')">🇫🇷 FR</button>
        </div>
        
        <a href="https://maps.google.com/?cid=12604620023476085208" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: var(--onDeep); background: var(--deep); border-radius: 20px; padding: 9px 16px;">
           <img src="/uploads/logo-tangara.png" alt="" style="height: 18px; width: auto; filter: brightness(0) invert(1);" /> Google Maps
        </a>

        <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n" target="_blank" class="btn-primary" style="padding: 9px 16px; font-size: 13.5px; white-space: nowrap;" data-i18n="btnBook">Reservar WhatsApp</a>
      </div>

      <button class="menu-toggle" type="button" aria-label="Abrir menú">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"><line x1="4" y1="8" x2="24" y2="8"/><line x1="4" y1="14" x2="24" y2="14"/><line x1="4" y1="20" x2="24" y2="20"/></svg>
      </button>
    </div>
  </header>

  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-header">
      <div style="display: flex; align-items: center; gap: 10px;">
        <img src="/uploads/logo-tangara.png" alt="Tangara Hostel Logo" style="height: 28px; width: auto; object-fit: contain;" />
        <span style="font-family: 'Lora', Georgia, serif; font-weight: 700; font-size: 21px; color: var(--onDeep);">Tangara Hostel</span>
      </div>
      <button class="menu-toggle" type="button" aria-label="Cerrar menú" style="display: flex;">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="var(--onDeep)" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="22" y2="22"/><line x1="22" y1="6" x2="6" y2="22"/></svg>
      </button>
    </div>
    
    <nav>
      <a href="#rooms" data-i18n="navRooms">Habitaciones</a>
      <a href="#whales" data-i18n="navWhales">Ballenas</a>
      <a href="#getting-here" data-i18n="navGettingHere">Cómo llegar</a>
      <a href="#contact-form-section" data-i18n="navContact">Contacto</a>
    </nav>

    <div class="mobile-menu-footer">
      <div style="display: flex; gap: 16px; justify-content: center; font-size: 14px; font-weight: 500;">
        <button type="button" class="lang-btn active" data-lang="es" onclick="changeLanguage('es')" style="color: var(--onDeep);">🇪🇸 Español</button>
        <span style="color: rgba(246,241,232,0.3);">/</span>
        <button type="button" class="lang-btn" data-lang="en" onclick="changeLanguage('en')" style="color: rgba(246,241,232,0.8);">🇬🇧 English</button>
        <span style="color: rgba(246,241,232,0.3);">/</span>
        <button type="button" class="lang-btn" data-lang="fr" onclick="changeLanguage('fr')" style="color: rgba(246,241,232,0.8);">🇫🇷 Français</button>
      </div>
      <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n" target="_blank" class="btn-primary" style="text-align: center; padding: 14px; font-size: 16px;" data-i18n="btnBook">Reservar por WhatsApp</a>
    </div>
  </div>

  <div class="mobile-whatsapp-bar">
    <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n" target="_blank" class="btn-primary" style="padding: 12px 18px; font-size: 14.5px; width: 100%;" data-i18n="btnBook">Reservar por WhatsApp</a>
  </div>

  <main>
    <section id="top" style="width: 100%;">
      <div style="position: relative; width: 100%; height: 85vh; min-height: 550px; overflow: hidden; background: var(--deep);">
        <video class="desktop-video" src="/uploads/TangaraWebHor2.mp4" autoplay muted loop playsinline preload="auto" poster="/uploads/IMG-20260420-WA0009.jpg"></video>
        <video class="mobile-video" src="/uploads/WEBTANGARAVERTICAL.mp4" autoplay muted loop playsinline preload="auto" poster="/uploads/IMG-20260420-WA0009.jpg"></video>

        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(28,26,23,.82) 0%, rgba(28,26,23,.3) 45%, transparent 75%);"></div>

        <div style="position: absolute; left: 40px; right: 40px; bottom: 50px; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; z-index: 2; max-width: 1280px; margin: 0 auto; width: calc(100% - 80px);">
          <div style="display: flex; flex-direction: column; gap: 16px; align-items: flex-start; max-width: 760px;">
            <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: rgba(246,241,232,.7);" data-i18n="heroTag">La Barra · Pacífico colombiano</span>
            <h1 style="margin: 0; display: flex; flex-direction: column; gap: 10px; font-family: 'Lora', Georgia, serif; font-weight: 500; color: var(--onDeep);">
              <span style="font-size: clamp(32px, 5vw, 50px); line-height: 1.05;" data-i18n="heroTitle">Hostal en la playa de La Barra, Pacífico Colombiano</span>
              <span style="font-size: clamp(18px, 3vw, 26px); line-height: 1.2; font-weight: 400; color: rgba(246,241,232,.82);" data-i18n="heroSubtitle">Tangara, en la costa de las ballenas</span>
            </h1>
