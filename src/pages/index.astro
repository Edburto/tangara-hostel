      </div>

      <button class="menu-toggle" type="button" aria-label="Abrir menú">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"><line x1="4" y1="8" x2="24
