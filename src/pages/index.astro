<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tangara Hostel · La Barra, Pacífico colombiano — hostal frente a la playa</title>
    <meta name="description" content="Hostal a 50 metros de la playa de La Barra, Buenaventura. Habitaciones con ventilador y toldillo, internet satelital, café recién hecho. Avistamiento de ballenas de julio a octubre. Desde $50.000 COP por persona.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #F4EFE6;
            --bg2: #EADFCD;
            --ink: #1F2A24;
            --deep: #1F2A24;
            --accent: #E07A5F;
            --accentDark: #c86348;
            --onDeep: #F6F1E8;
            --muted: #4a5c53;
            --rule: #d9cebc;
        }
        body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
        a { color: inherit; text-decoration: none; }
        a:hover { color: var(--accent); }
        img, video { max-width: 100%; display: block; }

        /* Videos Responsivos */
        .desktop-video { display: block; width: 100%; height: 100%; object-fit: cover; }
        .mobile-video { display: none; width: 100%; height: 100%; object-fit: cover; }
        @media (max-width: 768px) {
            .desktop-video { display: none; }
            .mobile-video { display: block; }
        }

        /* Botones y Secciones */
        .btn-primary {
            background: var(--accent);
            color: var(--onDeep);
            border-radius: 4px;
            padding: 14px 26px;
            font-size: 15px;
            font-weight: 600;
            display: inline-block;
            transition: background 0.2s;
        }
        .btn-primary:hover {
            background: var(--accentDark);
            color: var(--onDeep);
        }
    </style>
</head>
<body>

  <div style="background: var(--deep); color: rgba(246,241,232,.8); padding: 9px 2rem; display: flex; justify-content: space-between; align-items: center; font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase;">
    <span>Temporada de ballenas · Julio – Octubre</span>
    <span>La Barra, Pacífico colombiano · 15 min desde Juanchaco</span>
  </div>

  <header style="position: sticky; top: 0; z-index: 40; background: rgba(244, 239, 230, 0.92); backdrop-filter: blur(14px); border-bottom: 1px solid var(--rule);">
    <div style="max-width: 1280px; margin: 0 auto; padding: 16px 2rem; display: flex; align-items: center; justify-content: space-between;">
      <a href="#top" style="display: flex; align-items: center; gap: 11px;">
        <img src="/uploads/702876787_10165380027888900_2312760133940339429_n.jpg" alt="Logo Tangara Hostel" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover;" />
        <span style="font-family: 'Lora', Georgia, serif; font-weight: 700; font-size: 20px;">Tangara Hostel</span>
      </a>
      <nav style="display: flex; align-items: center; gap: 24px; font-size: 14.5px; font-weight: 500;">
        <a href="#rooms">Habitaciones</a>
        <a href="#whales">Ballenas</a>
        <a href="#playlist">Playlist</a>
        <a href="#contact">Contacto</a>
      </nav>
      <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n%20en%20Tangara%20Hostel" target="_blank" class="btn-primary" style="padding: 10px 18px; font-size: 14px;">Reservar WhatsApp</a>
    </div>
  </header>

  <main>
    <section id="top" style="padding: 24px 2rem;">
      <div style="position: relative; height: 620px; border-radius: 12px; overflow: hidden; background: var(--deep);">
        <video class="desktop-video" src="/uploads/TangaraWebHor2.mp4" autoplay muted loop playsinline preload="auto"></video>
        <video class="mobile-video" src="/uploads/WEBTANGARAVERTICAL.mp4" autoplay muted loop playsinline preload="auto"></video>
        
        <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(28,26,23,.85) 0%, rgba(28,26,23,.3) 50%, transparent 80%);"></div>
        
        <div style="position: absolute; left: 40px; right: 40px; bottom: 40px; color: var(--onDeep); display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 20px;">
          <div style="max-width: 650px;">
            <span style="font-family: ui-monospace, Menlo, monospace; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: rgba(246,241,232,.7);">La Barra · Pacífico colombiano</span>
            <h1 style="margin: 10px 0; font-family: 'Lora', Georgia, serif; font-size: 42px; font-weight: 500; line-height: 1.1;">Hostal en la playa de La Barra</h1>
            <p style="margin: 0 0 20px 0; font-size: 17px; color: rgba(246,241,232,.8);">A cincuenta metros de una playa tranquila. Habitaciones con ventilador, toldillo e internet satelital.</p>
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
              <a href="https://wa.me/573152395357?text=Hola,%20quiero%20reservar%20una%20habitaci%C3%B3n" target="_blank" class="btn-primary">Reservar por WhatsApp</a>
            </div>
          </div>
          <div style="text-align: right;">
            <span style="font-family: 'Lora', Georgia, serif; font-size: 36px; font-weight: 500; display: block;">$50.000</span>
            <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: rgba(246,241,232,.7);">COP · persona / noche</span>
          </div>
        </div>
      </div>
    </section>

    <section id="rooms" style="max-width: 1280px; margin: 0 auto; padding: 60px 2rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <img src="/uploads/IMG-20260406-WA0063.jpg" alt="Hamacas en la terraza" style="width: 100%; height: 320px; object-fit: cover; border-radius: 4px;" />
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .16em; color: var(--deep);">01 — Alojamiento</span>
        <h2 style="margin: 0; font-family: 'Lora', Georgia, serif; font-weight: 500; font-size: 28px;">Habitaciones frescas, café al amanecer</h2>
        <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--muted);">Habitaciones con ventilador y toldillo para dormir protegido, termo de café fresco cada mañana e internet satelital de alta velocidad.</p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <img src="/uploads/IMG-20260420-WA0011.jpg" alt="Entrada al hostal" style="width: 100%; height: 320px; object-fit: cover; border-radius: 4px;" />
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .16em; color: var(--deep);">02 — Entorno</span>
        <h2 style="margin: 0; font-family: 'Lora', Georgia, serif; font-weight: 500; font-size: 28px;">Ballenas, manglares y surf</h2>
        <p style="margin: 0; font-size: 16px; line-height: 1.5; color: var(--muted);">Avistamiento de ballenas en temporada, senderos por los esteros, manglares y las mejores olas del Pacífico.</p>
      </div>
    </section>

    <section id="playlist" style="background: var(--bg2); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 70px 2rem; text-align: center;">
      <div style="max-width: 700px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; align-items: center;">
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted);">Ambiente Pacífico</span>
        <h2 style="margin: 0; font-family: 'Lora', Georgia, serif; font-size: 36px; font-weight: 500;">Escucha la música de Tangara</h2>
        <p style="margin: 0; font-size: 16px; color: var(--muted); line-height: 1.5;">Salsa, currulao y sonidos del litoral para ambientar tu estadía o recordarte el mar.</p>
        
        <div style="width: 100%; margin-top: 10px; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <iframe style="border-radius:12px" src="https://open.spotify.com/embed/playlist/37i9dQZF1DXcBWIGoYBM5M?utm_source=generator&theme=0" width="100%" height="352" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
      </div>
    </section>
  </main>

  <footer id="contact" style="background: var(--deep); color: var(--onDeep); padding: 70px 2rem 40px;">
    <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 40px; margin-bottom: 40px;">
      <div style="display: flex; flex-direction: column; gap: 14px; align-items: flex-start;">
        <img src="/uploads/702876787_10165380027888900_2312760133940339429_n.jpg" alt="Logo Tangara Hostel" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
        <span style="font-family: 'Lora', Georgia, serif; font-weight: 700; font-size: 22px;">Tangara Hostel</span>
        <p style="margin: 0; font-size: 15px; color: rgba(246,241,232,.7); line-height: 1.5;">La Barra, Buenaventura<br>Valle del Cauca, Colombia</p>
        <a href="https://wa.me/573152395357?text=Hola,%20quiero%20información" target="_blank" class="btn-primary" style="margin-top: 10px;">Escríbenos por WhatsApp</a>
      </div>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <span style="font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: rgba(246,241,232,.5);">Contacto directo</span>
        <a href="https://wa.me/573152395357" target="_blank" style="font-size: 15px; color: rgba(246,241,232,.8);">+57 315 239 5357</a>
        <a href="mailto:hola@tangarahostel.co" style="font-size: 15px; color: rgba(246,241,232,.8);">hola@tangarahostel.co</a>
        <a href="https://www.instagram.com/tangarahostel" target="_blank" style="font-size: 15px; color: rgba(246,241,232,.8);">@tangarahostel</a>
      </div>
    </div>
    <div style="max-width: 1280px; margin: 0 auto; border-top: 1px solid rgba(246,241,232,.15); padding-top: 20px; display: flex; justify-content: space-between; font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: rgba(246,241,232,.5);">
      <span>© 2026 Tangara Hostel</span><span>Pacífico colombiano</span>
    </div>
  </footer>

</body>
</html>